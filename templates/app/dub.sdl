name "xtb-app"
description "BetterC application using xtb"
license "proprietary"

targetType "executable"
targetName "xtb-app"
targetPath "build"
sourcePaths "source"
importPaths "source" "$XTB_IMPORT_PATH"

buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"

// Optimized checked build.
buildType "release-safe" {
    buildOptions "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}
lflags "-L$XTB_LIBRARY_PATH"

// The monolithic archive contains one object per module, so the linker pulls
// only the XTB modules used by the application while every package remains
// available without maintaining component-library order here.
libs "xtb"
libs "backtrace" platform="linux"
libs "pthread" platform="linux"

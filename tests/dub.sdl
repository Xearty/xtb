name "tests"
description "Explicit BetterC test runners"
license "BSL-1.0"
targetType "none"
importPaths ".." "../source"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"

buildType "test-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
}

buildType "test-optimized" {
    buildOptions "unittests" "optimize" "inline"
}

buildType "test-release-safe" {
    buildOptions "unittests" "optimize" "inline"
}

buildType "test-release-fast" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
}

buildType "test-asan" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-fsanitize=address" platform="ldc"
}

configuration "test-helper-process" {
    targetType "executable"
    targetName "process_test_helper"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "support/process_helper.d"
}

configuration "test-utf8" {
    targetType "executable"
    targetName "utf8_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "utf8_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d"
}

configuration "test-core" {
    targetType "executable"
    targetName "core_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "core_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/diagnostics/*.d"
    libs "backtrace" platform="linux"
}

configuration "test-lifetime" {
    targetType "executable"
    targetName "lifetime_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "lifetime_tests.d"
    sourceFiles "../source/xtb/core/lifetime.d" "../source/xtb/core/types.d" "../source/xtb/core/memory.d" "../source/xtb/core/numeric.d" "../source/xtb/core/panic.d" "../source/xtb/core/allocators/instrumented.d" "../source/xtb/core/allocators/malloc.d"
}

configuration "test-option-result" {
    targetType "executable"
    targetName "option_result_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "option_result_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d"
}

configuration "test-array" {
    targetType "executable"
    targetName "array_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "array_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d"
}

configuration "test-arena" {
    targetType "executable"
    targetName "arena_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "arena_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d"
}

configuration "test-hash" {
    targetType "executable"
    targetName "hash_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "hash_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d"
}

configuration "test-pretty-print" {
    targetType "executable"
    targetName "pretty_print_tests"
    // This configuration is intentionally runnable directly with `dub run`;
    // unlike the repository-wide test recipes it does not require the
    // `XTB_TEST_MODE` environment variable normally supplied by `just`.
    targetPath "../build/test/pretty_print"
    mainSourceFile "pretty_print_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d"
}

configuration "test-math" {
    targetType "executable"
    targetName "math_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "math_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/math/*.d"
}

configuration "test-os" {
    targetType "executable"
    targetName "os_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "os_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/os/*.d"
}

configuration "test-serde" {
    targetType "executable"
    targetName "serde_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "serde_tests.d"
    sourceFiles "serde_backend_contract.d" "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/serde/*.d"
}

configuration "test-pretty-print-serde" {
    targetType "executable"
    targetName "pretty_print_serde_tests"
    // Keep the direct serde runner independent of `XTB_TEST_MODE` too.
    targetPath "../build/test/pretty_print_serde"
    mainSourceFile "pretty_print_serde_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/serde/*.d"
}

configuration "test-parser" {
    targetType "executable"
    targetName "parser_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "parser_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/parser/*.d"
}

configuration "test-threading" {
    targetType "executable"
    targetName "threading_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "threading_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/threading/*.d" "../source/xtb/threading/internal/*.d"
    libs "pthread" platform="linux"
}

configuration "test-threading-unsupported" {
    targetType "executable"
    targetName "threading_unsupported_tests"
    targetPath "../build/test/$XTB_TEST_MODE"
    mainSourceFile "threading_unsupported_tests.d"
    sourceFiles "../source/xtb/core/*.d" "../source/xtb/core/allocators/*.d" "../source/xtb/threading/*.d" "../source/xtb/threading/internal/*.d"
    excludedSourceFiles "../source/xtb/threading/internal/thread_linux.d"
    versions "XTB_TestUnsupportedThreadBackend"
}

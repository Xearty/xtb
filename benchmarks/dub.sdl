name "benchmarks"
description "Opt-in XTB microbenchmarks"
license "BSL-1.0"
targetType "none"
importPaths "../source"
dependency "xtb" path=".."
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"

configuration "logging" {
    targetType "executable"
    targetName "logging_benchmark"
    targetPath "../build/benchmarks"
    mainSourceFile "logging.d"
}

configuration "pools" {
    targetType "executable"
    targetName "pools_benchmark"
    targetPath "../build/benchmarks"
    mainSourceFile "pools.d"
}

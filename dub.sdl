name "xtb"
description "BetterC-first foundational libraries"
license "BSL-1.0"
targetType "staticLibrary"
targetName "xtb"
targetPath "$XTB_LIBRARY_OUTPUT_DIR"
sourcePaths "source"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"

// Optimized checked build: keep language assertions and contracts enabled.
buildType "release-safe" {
    buildOptions "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}
libs "backtrace" platform="linux"
libs "pthread" platform="linux"

subPackage "source/xtb/core"
subPackage "source/xtb/cli"
subPackage "source/xtb/diagnostics"
subPackage "source/xtb/math"
subPackage "source/xtb/os"
subPackage "source/xtb/parser"
subPackage "source/xtb/serde"
subPackage "source/xtb/threading"
subPackage "examples"
subPackage "tests"

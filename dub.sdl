name "xtb"
description "BetterC-first foundational libraries"
license "BSL-1.0"
targetType "staticLibrary"
targetName "xtb"
targetPath "$XTB_LIBRARY_OUTPUT_DIR"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"

buildType "release-safe" {
    buildOptions "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}


buildType "unit-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
}

buildType "unit-optimized" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}

buildType "unit-release-safe" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}

buildType "unit-release-fast" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
}

buildType "unit-asan" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-fsanitize=address" platform="ldc"
}

subPackage "source/core"
subPackage "source/os"
subPackage "source/terminal"
subPackage "source/fs"
subPackage "source/process"
subPackage "source/time"
subPackage "source/window"
subPackage "source/opengl"
subPackage "source/log"
subPackage "source/math"
subPackage "source/threading"
subPackage "source/parser"
subPackage "source/serde"
subPackage "source/cli"
subPackage "source/diagnostics"
subPackage "examples"
subPackage "benchmarks"
subPackage "tests"
subPackage "tests/zero_cost"
subPackage "tools/compose"

dependency ":core" version="*"
dependency ":os" version="*"
dependency ":terminal" version="*"
dependency ":fs" version="*"
dependency ":process" version="*"
dependency ":time" version="*"
dependency ":window" version="*"
dependency ":opengl" version="*"
dependency ":log" version="*"
dependency ":math" version="*"
dependency ":threading" version="*"
dependency ":parser" version="*"
dependency ":serde" version="*"
dependency ":cli" version="*"
dependency ":diagnostics" version="*"

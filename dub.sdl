name "xtb"
description "BetterC-first foundational libraries"
license "BSL-1.0"
targetType "staticLibrary"
targetName "xtb"
targetPath "$XTB_LIBRARY_OUTPUT_DIR"
sourcePaths "source"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-boundscheck=on" "-preview=dip1000" platform="ldc"
libs "backtrace" platform="linux"

subPackage "source/xtb/core"
subPackage "source/xtb/diagnostics"
subPackage "source/xtb/math"
subPackage "source/xtb/os"
subPackage "source/xtb/serde"
subPackage "examples"
subPackage "tests"

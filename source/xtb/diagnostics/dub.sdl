name "diagnostics"
description "BetterC stack traces and crash diagnostics"
license "BSL-1.0"
targetType "staticLibrary"
targetName "xtb_diagnostics"
targetPath "$XTB_LIBRARY_OUTPUT_DIR"
sourceFiles "*.d"
importPaths "../.."
dependency "xtb:core" version="*"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"

// Optimized checked build: keep language assertions and contracts enabled.
buildType "release-safe" {
    buildOptions "optimize" "inline"
}
libs "backtrace" platform="linux"

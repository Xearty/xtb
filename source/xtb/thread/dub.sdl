name "threading"
description "Combined build target for xtb.thread and xtb.sync"
license "BSL-1.0"
targetType "staticLibrary"
targetName "xtb_threading"
targetPath "$XTB_LIBRARY_OUTPUT_DIR"
sourceFiles "*.d" "internal/*.d" "../sync/*.d" "../sync/internal/*.d"
importPaths "../.."
dependency "xtb:core" version="*"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-preview=dip1000" platform="ldc"
libs "pthread" platform="linux"

buildType "release-safe" {
    buildOptions "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}

buildType "unit-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
}

buildType "unit-optimized" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}

buildType "unit-release-safe" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-fno-delete-null-pointer-checks" platform="ldc"
}

buildType "unit-release-fast" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
}

buildType "unit-asan" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-fsanitize=address" platform="ldc"
}

name "os"
description "BetterC operating-system facilities"
license "BSL-1.0"
targetType "staticLibrary"
targetName "xtb_os"
targetPath "$XTB_LIBRARY_OUTPUT_DIR"
sourceFiles "*.d"
importPaths "../.."
dependency "xtb:core" version="*"
buildOptions "betterC"
buildRequirements "disallowDeprecations"
dflags "-boundscheck=on" "-preview=dip1000" platform="ldc"

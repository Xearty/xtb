set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

core_source_files := `find source/xtb/core -name '*.d' -print | sort | tr '\n' ' '`
diagnostics_source_files := `find source/xtb/diagnostics -name '*.d' -print | sort | tr '\n' ' '`
math_source_files := `find source/xtb/math -name '*.d' -print | sort | tr '\n' ' '`
os_source_files := `find source/xtb/os -name '*.d' -print | sort | tr '\n' ' '`
serde_source_files := `find source/xtb/serde -name '*.d' -print | sort | tr '\n' ' '`
fuzz_core_source_files := "source/xtb/core/array.d source/xtb/core/memory.d source/xtb/core/numeric.d source/xtb/core/panic.d source/xtb/core/string.d source/xtb/core/types.d"
lint_files := `find source tests examples -name '*.d' ! -path 'source/xtb/diagnostics/stacktrace_style.d' -print | sort | tr '\n' ' '`
fuzz_files := `find fuzz -name '*.d' -print | sort | tr '\n' ' '`
format_files := `find source tests examples fuzz -name '*.d' -print | sort | tr '\n' ' '`
platform_libs := `if uname -s | grep -q Linux; then if test -n "${XTB_LIBBACKTRACE:-}"; then echo "-L${XTB_LIBBACKTRACE}"; else echo '-L-lbacktrace'; fi; fi`
common_flags := "-betterC -boundscheck=on -w -de -preview=dip1000 -I=source -od=build/obj"

default: check

format:
    dfmt --config . --inplace {{format_files}}

build:
    mkdir -p build/obj
    ldc2 {{common_flags}} -oq -lib {{core_source_files}} -of=build/libxtbd_core.a
    ldc2 {{common_flags}} -oq -lib {{diagnostics_source_files}} -of=build/libxtbd_diagnostics.a
    ldc2 {{common_flags}} -oq -lib {{math_source_files}} -of=build/libxtbd_math.a
    ldc2 {{common_flags}} -oq -lib {{os_source_files}} -of=build/libxtbd_os.a
    ldc2 {{common_flags}} -oq -lib {{serde_source_files}} -of=build/libxtbd_serde.a

test:
    mkdir -p build/obj
    ldc2 {{common_flags}} -unittest tests/core_tests.d {{core_source_files}} {{diagnostics_source_files}} {{platform_libs}} -of=build/core_tests
    ./build/core_tests
    ldc2 {{common_flags}} -unittest tests/math_tests.d {{core_source_files}} {{math_source_files}} -of=build/math_tests
    ./build/math_tests
    ldc2 {{common_flags}} -unittest tests/os_tests.d {{core_source_files}} {{os_source_files}} -of=build/os_tests
    ./build/os_tests
    ldc2 {{common_flags}} -unittest tests/serde_tests.d {{core_source_files}} {{serde_source_files}} -of=build/serde_tests
    ./build/serde_tests

test-optimized:
    mkdir -p build/obj
    ldc2 {{common_flags}} -unittest -O3 tests/core_tests.d {{core_source_files}} {{diagnostics_source_files}} {{platform_libs}} -of=build/core_tests_optimized
    ./build/core_tests_optimized
    ldc2 {{common_flags}} -unittest -O3 tests/math_tests.d {{core_source_files}} {{math_source_files}} -of=build/math_tests_optimized
    ./build/math_tests_optimized
    ldc2 {{common_flags}} -unittest -O3 tests/os_tests.d {{core_source_files}} {{os_source_files}} -of=build/os_tests_optimized
    ./build/os_tests_optimized
    ldc2 {{common_flags}} -unittest -O3 tests/serde_tests.d {{core_source_files}} {{serde_source_files}} -of=build/serde_tests_optimized
    ./build/serde_tests_optimized

test-release:
    mkdir -p build/obj
    ldc2 {{common_flags}} -unittest -O3 -release tests/core_tests.d {{core_source_files}} {{diagnostics_source_files}} {{platform_libs}} -of=build/core_tests_release
    ./build/core_tests_release
    ldc2 {{common_flags}} -unittest -O3 -release tests/math_tests.d {{core_source_files}} {{math_source_files}} -of=build/math_tests_release
    ./build/math_tests_release
    status=0; bash -c './build/math_tests_release --panic-random-bound >/dev/null 2>&1' >/dev/null 2>&1 || status=$?; test "$status" -eq 134
    ldc2 {{common_flags}} -unittest -O3 -release tests/os_tests.d {{core_source_files}} {{os_source_files}} -of=build/os_tests_release
    ./build/os_tests_release
    ldc2 {{common_flags}} -unittest -O3 -release tests/serde_tests.d {{core_source_files}} {{serde_source_files}} -of=build/serde_tests_release
    ./build/serde_tests_release

test-darwin-build:
    mkdir -p build/obj
    ldc2 {{common_flags}} -mtriple=aarch64-apple-darwin -oq -lib {{core_source_files}} -of=build/libxtbd_core_aarch64_darwin.a
    ldc2 {{common_flags}} -mtriple=aarch64-apple-darwin -oq -lib {{diagnostics_source_files}} -of=build/libxtbd_diagnostics_aarch64_darwin.a
    ldc2 {{common_flags}} -mtriple=aarch64-apple-darwin -oq -lib {{math_source_files}} -of=build/libxtbd_math_aarch64_darwin.a
    ldc2 {{common_flags}} -mtriple=aarch64-apple-darwin -oq -lib {{os_source_files}} -of=build/libxtbd_os_aarch64_darwin.a
    ldc2 {{common_flags}} -mtriple=aarch64-apple-darwin -oq -lib {{serde_source_files}} -of=build/libxtbd_serde_aarch64_darwin.a

test-sanitize:
    mkdir -p build/obj
    ldc2 {{common_flags}} -unittest -fsanitize=address {{core_source_files}} {{diagnostics_source_files}} tests/core_tests.d {{platform_libs}} -of=build/core_tests_asan
    ./build/core_tests_asan
    ldc2 {{common_flags}} -unittest -fsanitize=address tests/math_tests.d {{core_source_files}} {{math_source_files}} -of=build/math_tests_asan
    ./build/math_tests_asan
    ldc2 {{common_flags}} -unittest -fsanitize=address tests/os_tests.d {{core_source_files}} {{os_source_files}} -of=build/os_tests_asan
    ./build/os_tests_asan
    ldc2 {{common_flags}} -unittest -fsanitize=address tests/serde_tests.d {{core_source_files}} {{serde_source_files}} -of=build/serde_tests_asan
    ./build/serde_tests_asan

test-ubsan:
    mkdir -p build/obj
    if ldc2 -betterC -fsanitize=undefined -c source/xtb/core/types.d -of=build/ubsan_probe.o >/dev/null 2>&1; then \
        ldc2 {{common_flags}} -unittest -fsanitize=undefined {{core_source_files}} {{diagnostics_source_files}} tests/core_tests.d {{platform_libs}} -of=build/core_tests_ubsan; \
        ./build/core_tests_ubsan; \
        ldc2 {{common_flags}} -unittest -fsanitize=undefined tests/math_tests.d {{core_source_files}} {{math_source_files}} -of=build/math_tests_ubsan; \
        ./build/math_tests_ubsan; \
        ldc2 {{common_flags}} -unittest -fsanitize=undefined tests/os_tests.d {{core_source_files}} {{os_source_files}} -of=build/os_tests_ubsan; \
        ./build/os_tests_ubsan; \
        ldc2 {{common_flags}} -unittest -fsanitize=undefined tests/serde_tests.d {{core_source_files}} {{serde_source_files}} -of=build/serde_tests_ubsan; \
        ./build/serde_tests_ubsan; \
    else \
        echo "UBSan is not supported by this LDC build; skipped"; \
    fi

fuzz-smoke:
    mkdir -p build/obj
    ldc2 {{common_flags}} -c -singleobj -fsanitize=address -fsanitize-coverage=inline-8bit-counters,pc-table fuzz/demangle_fuzz.d source/xtb/diagnostics/demangle.d {{fuzz_core_source_files}} -of=build/demangle_fuzz.o
    clang++ -fsanitize=fuzzer,address build/demangle_fuzz.o -o build/demangle_fuzz
    ./build/demangle_fuzz -runs=1000 -max_len=512
    ldc2 {{common_flags}} -c -singleobj -fsanitize=address -fsanitize-coverage=inline-8bit-counters,pc-table fuzz/container_fuzz.d {{fuzz_core_source_files}} -of=build/container_fuzz.o
    clang++ -fsanitize=fuzzer,address build/container_fuzz.o -o build/container_fuzz
    ./build/container_fuzz -runs=1000 -max_len=512
    ldc2 {{common_flags}} -c -singleobj -fsanitize=address -fsanitize-coverage=inline-8bit-counters,pc-table fuzz/serde_fuzz.d {{core_source_files}} {{serde_source_files}} -of=build/serde_fuzz.o
    clang++ -fsanitize=fuzzer,address build/serde_fuzz.o -o build/serde_fuzz
    ./build/serde_fuzz -runs=2000 -max_len=2048

test-abi:
    mkdir -p build/obj
    clang -std=c11 -Wall -Wextra -Werror -c tests/abi_allocator.c -o build/abi_allocator_c.o
    ldc2 {{common_flags}} {{core_source_files}} tests/abi_allocator.d build/abi_allocator_c.o -of=build/abi_allocator
    ./build/abi_allocator

examples:
    mkdir -p build/obj
    ldc2 {{common_flags}} {{core_source_files}} examples/core_demo.d -of=build/core_demo
    ldc2 {{common_flags}} {{core_source_files}} examples/print_demo.d -of=build/print_demo
    ldc2 {{common_flags}} -g {{core_source_files}} {{diagnostics_source_files}} examples/stacktrace_demo.d {{platform_libs}} -of=build/stacktrace_demo
    ldc2 {{common_flags}} {{core_source_files}} {{math_source_files}} examples/math_demo.d -of=build/math_demo
    ldc2 {{common_flags}} {{core_source_files}} {{os_source_files}} examples/os_demo.d -of=build/os_demo
    ldc2 {{common_flags}} {{core_source_files}} {{serde_source_files}} examples/serde_demo.d -of=build/serde_demo
    ldc2 {{common_flags}} {{core_source_files}} {{serde_source_files}} examples/option_demo.d -of=build/option_demo
    ./build/core_demo
    ./build/print_demo
    ./build/stacktrace_demo
    ./build/math_demo
    ./build/os_demo source
    ./build/serde_demo
    ./build/option_demo

lint:
    dscanner --syntaxCheck source/xtb/diagnostics/stacktrace_style.d
    dscanner --syntaxCheck {{fuzz_files}}
    dscanner lint --config dscanner.ini --styleCheck {{lint_files}}

check: lint build test test-optimized test-release test-darwin-build test-abi test-sanitize test-ubsan fuzz-smoke examples

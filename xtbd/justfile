set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

source_files := `find source -name '*.d' -print | sort | tr '\n' ' '`
math_source_files := `printf '%s ' source/xtb/math/random.d; find source -name '*.d' ! -path 'source/xtb/math/random.d' -print | sort | tr '\n' ' '`
os_source_files := `printf '%s ' source/xtb/os/path.d; find source -name '*.d' ! -path 'source/xtb/os/path.d' -print | sort | tr '\n' ' '`
lint_files := `find source tests examples -name '*.d' ! -path 'source/xtb/core/stacktrace_style.d' -print | sort | tr '\n' ' '`
platform_libs := `if uname -s | grep -q Linux; then if test -n "${XTB_LIBBACKTRACE:-}"; then echo "-L${XTB_LIBBACKTRACE}"; else echo '-L-lbacktrace'; fi; fi`

default: check

format:
    dfmt --inplace source/xtb/math/*.d source/xtb/os/*.d tests/math_tests.d tests/os_tests.d examples/math_demo.d examples/os_demo.d

build:
    mkdir -p build
    ldc2 -betterC -boundscheck=on -wi -de -oq -I=source -lib {{source_files}} -of=build/libxtbd.a

test:
    mkdir -p build
    ldc2 -betterC -unittest -boundscheck=on -wi -de -I=source tests/core_tests.d {{source_files}} {{platform_libs}} -of=build/core_tests
    ./build/core_tests
    ldc2 -betterC -unittest -boundscheck=on -wi -de -I=source tests/math_tests.d {{math_source_files}} {{platform_libs}} -of=build/math_tests
    ./build/math_tests
    ldc2 -betterC -unittest -boundscheck=on -wi -de -I=source tests/os_tests.d {{os_source_files}} {{platform_libs}} -of=build/os_tests
    ./build/os_tests

test-optimized:
    mkdir -p build
    ldc2 -betterC -unittest -O3 -boundscheck=on -wi -de -I=source tests/core_tests.d {{source_files}} {{platform_libs}} -of=build/core_tests_optimized
    ./build/core_tests_optimized
    ldc2 -betterC -unittest -O3 -boundscheck=on -wi -de -I=source tests/math_tests.d {{math_source_files}} {{platform_libs}} -of=build/math_tests_optimized
    ./build/math_tests_optimized
    ldc2 -betterC -unittest -O3 -boundscheck=on -wi -de -I=source tests/os_tests.d {{os_source_files}} {{platform_libs}} -of=build/os_tests_optimized
    ./build/os_tests_optimized

test-darwin-build:
    mkdir -p build
    ldc2 -betterC -mtriple=aarch64-apple-darwin -boundscheck=on -wi -de -oq -I=source -lib {{source_files}} -of=build/libxtbd_aarch64_darwin.a

test-sanitize:
    mkdir -p build
    ldc2 -betterC -unittest -boundscheck=on -wi -de -fsanitize=address -I=source {{source_files}} tests/core_tests.d {{platform_libs}} -of=build/core_tests_asan
    ./build/core_tests_asan
    ldc2 -betterC -unittest -boundscheck=on -wi -de -fsanitize=address -I=source tests/math_tests.d {{math_source_files}} {{platform_libs}} -of=build/math_tests_asan
    ./build/math_tests_asan
    ldc2 -betterC -unittest -boundscheck=on -wi -de -fsanitize=address -I=source tests/os_tests.d {{os_source_files}} {{platform_libs}} -of=build/os_tests_asan
    ./build/os_tests_asan

test-ubsan:
    mkdir -p build
    if ldc2 -betterC -fsanitize=undefined -c source/xtb/core/types.d -of=build/ubsan_probe.o >/dev/null 2>&1; then \
        ldc2 -betterC -unittest -boundscheck=on -wi -de -fsanitize=undefined -I=source {{source_files}} tests/core_tests.d {{platform_libs}} -of=build/core_tests_ubsan; \
        ./build/core_tests_ubsan; \
        ldc2 -betterC -unittest -boundscheck=on -wi -de -fsanitize=undefined -I=source tests/math_tests.d {{math_source_files}} {{platform_libs}} -of=build/math_tests_ubsan; \
        ./build/math_tests_ubsan; \
        ldc2 -betterC -unittest -boundscheck=on -wi -de -fsanitize=undefined -I=source tests/os_tests.d {{os_source_files}} {{platform_libs}} -of=build/os_tests_ubsan; \
        ./build/os_tests_ubsan; \
    else \
        echo "UBSan is not supported by this LDC build; skipped"; \
    fi

test-abi:
    mkdir -p build
    clang -std=c11 -Wall -Wextra -Werror -c tests/abi_allocator.c -o build/abi_allocator_c.o
    ldc2 -betterC -boundscheck=on -wi -de -I=source {{source_files}} tests/abi_allocator.d build/abi_allocator_c.o {{platform_libs}} -of=build/abi_allocator
    ./build/abi_allocator

examples:
    mkdir -p build
    ldc2 -betterC -boundscheck=on -wi -de -I=source {{source_files}} examples/core_demo.d {{platform_libs}} -of=build/core_demo
    ldc2 -betterC -boundscheck=on -wi -de -I=source {{source_files}} examples/print_demo.d {{platform_libs}} -of=build/print_demo
    ldc2 -betterC -g -boundscheck=on -wi -de -I=source {{source_files}} examples/stacktrace_demo.d {{platform_libs}} -of=build/stacktrace_demo
    ldc2 -betterC -boundscheck=on -wi -de -I=source {{source_files}} examples/math_demo.d {{platform_libs}} -of=build/math_demo
    ldc2 -betterC -boundscheck=on -wi -de -I=source {{source_files}} examples/os_demo.d {{platform_libs}} -of=build/os_demo
    ./build/core_demo
    ./build/print_demo
    ./build/stacktrace_demo
    ./build/math_demo
    ./build/os_demo source

lint:
    dscanner --syntaxCheck source/xtb/core/stacktrace_style.d
    dscanner lint --config dscanner.ini --styleCheck {{lint_files}}

check: lint build test test-optimized test-darwin-build test-abi test-ubsan examples
